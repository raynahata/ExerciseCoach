if current_round == 1:  # If we are in the social session
    while current_set < 4:  # 4 sets in each round
        # Start a new set
        sp.text_to_speech(f"Let's do some {exercise_list[current_set]}.")
        messages.append({"role": "system", "content": f"Let's do some {exercise_list[current_set]}."})

        inittime = datetime.now(timezone('EST'))

        # Exercise phase (20 seconds per set)
        while (datetime.now(timezone('EST')) - inittime).total_seconds() < 20:
            conversational_phrase = await coa.robot_response(messages, "conversation_history.csv")
            sp.text_to_speech(conversational_phrase)
            messages.append({"role": "assistant", "content": conversational_phrase})

            # Listen for user response
            user_message = await start_transcription()
            log_conversation("User", user_message, csv_file="conversation_log.csv")
            print("You:", user_message)

            # Check for "bye" to end conversation
            if user_message.lower().replace(" ", "").strip(string.punctuation) == "bye":
                done_intro_chat = True
                print("Ending conversation.")
                messages.append({"role": "user", "content": user_message})
                return  # Exit early if the user ends the session

        # End of the set
        sp.text_to_speech("Done with the set.")
        messages.append({"role": "system", "content": "Done with the set."})
        current_set += 1

        # Rest phase (40 seconds between sets)
        if current_set < 4:  # No rest after the last set
            sp.text_to_speech("Take a rest for 40 seconds.")
            messages.append({"role": "system", "content": "Take a rest for 40 seconds."})
            rest_start_time = datetime.now(timezone('EST'))

            while (datetime.now(timezone('EST')) - rest_start_time).total_seconds() < 40:
                # Optional: Add conversational elements during rest
                rest_phrase = await coa.robot_response(messages, "conversation_history.csv")
                sp.text_to_speech(rest_phrase)
                messages.append({"role": "assistant", "content": rest_phrase})

    sp.text_to_speech("Great job completing this round!")
    messages.append({"role": "system", "content": "Great job completing this round!"})